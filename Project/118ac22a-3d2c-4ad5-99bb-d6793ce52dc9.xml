{"CLs":[{"__type":"IST","EID":"0963b443-dd20-4041-8944-e112e9e62b00","H":302.80000000000013,"TXT":"\/\/\/\/ Conversion a LREAL del feedback de posicion de M1\u000d\u000aM1_Posicion_LREAL:=DINT_TO_LREAL(M1_Posicion);\u000d\u000aM1_FrequencyRefderence:=UINT#5000;\u000d\u000a\u000d\u000a\u000d\u000a\/\/\/Fuente de Maestro a seguir\u000d\u000aIF Master_Encoder THEN\u000d\u000a\u0009Seguir_Encoder:=TRUE;\u000d\u000a\u0009Seguir_MasterAxis:=FALSE;\u000d\u000a\u0009Seguir_Cam:=FALSE;\u000d\u000aELSIF Master_VirtualAxis THEN\u000d\u000a\u0009Seguir_MasterAxis:=TRUE;\u000d\u000a\u0009Seguir_Encoder:=FALSE;\u000d\u000a\u0009Seguir_Cam:=FALSE;\u000d\u000aELSIF Master_Cam THEN\u000d\u000a\u0009Seguir_Cam:=TRUE;\u000d\u000a\u0009Seguir_Encoder:=FALSE;\u000d\u000a\u0009Seguir_MasterAxis:=FALSE;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\u000d\u000aIF Seguimiento THEN  \/\/\/ Si queremos activar el modo de posicion en M1\u000d\u000a\u0009S5:=false;\u0009\u000d\u000a\u0009IF Seguir_Encoder THEN\u000d\u000a\u0009\u0009LREAL_TO_MSBLSB(M1_position_ValueMSB,Encoder_Axis.Act.Pos,M1_position_ValueLSB);\u000d\u000a\u0009ELSIF Seguir_MasterAxis THEN\u000d\u000a\u0009\u0009LREAL_TO_MSBLSB(M1_position_ValueMSB,VirtualX.Act.Pos,M1_position_ValueLSB);\u000d\u000a\u0009ELSIF Seguir_Cam then\u0009\u000d\u000a\u0009\u0009LREAL_TO_MSBLSB(M1_position_ValueMSB,VirtualCAM.Act.Pos,M1_position_ValueLSB);\u000d\u000a\u0009END_IF;\u000d\u000a\u0009RunFW:=TRUE;\u000d\u000aELSE\u000d\u000a\u0009S5:=TRUE;\u000d\u000a\u0009RunFW:=FALSE;\u000d\u000aEND_IF;\u0009\u000d\u000a\u0009\u000d\u000a\u0009 \u000d\u000a\u0009\u000d\u000a\u0009\u000d\u000a\u0009\u000d\u000a\u0009\u000d\u000a","W":1078.3999999999999}],"LRI":1,"RRI":2,"VLs":[]}
{"CLs":[{"__type":"IST","EID":"b133a8af-21d8-42c8-be3b-6ec9ea67d775","H":848.4,"TXT":"\/\/\/\/\/Simulacion Encoder PLC\/\/\u000d\u000a\u000d\u000a\/\/\/\/\/\/\/\/\/Sumar error continuo\/\/\/\/\/\/\/\/\/\/\/\/\/\u000d\u000aT_Exe:=TRUE;\u000d\u000aIF T_Q and Sumar_continuo and I_MoveAbs.Busy Then\u000d\u000aRandom(TRUE,UINT#1,Offset);\u000d\u000aOffset_Encoder:=Offset_Encoder +Offset;\u000d\u000aT_Exe:=FALSE;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\/\/\/\/\/\/\/Sumar Error Inicio Mov\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\u000d\u000a\u000d\u000aIF  Sumar_InicioMov and InicioMovQ Then\u000d\u000aOffset_Inicio:=-5000;\u000d\u000aOffset_Encoder:=Offset_Encoder +Offset_Inicio;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\/\/\/\/\/\/\/\/\/Sumar Error Final Mov\/\/\/\/\/\/\/\/\/\/\/\/\/\/\u000d\u000aIF  Sumar_FinalMov and FinalMovQ Then\u000d\u000aOffset_final:=3000;\u000d\u000aOffset_Encoder:=Offset_Encoder +Offset_final;\u000d\u000aSumar_FinalMov:=FALSE;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000aFinalMov(I_MoveAbs.Busy,FinalMovQ);\u000d\u000aInicioMov(I_MoveAbs.Busy,InicioMovQ);\u000d\u000a\u000d\u000a\u000d\u000aEncoderPLC:= M1_Posicion_LREAL+ Offset_Encoder;\u000d\u000a\u000d\u000a\u000d\u000aIF ABS(M1_Posicion_LREAL -EncoderPLC) > 5 THEN\u000d\u000a\u0009Realizar_Preset:=TRUE;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000aIf Home THEN\u000d\u000a\u0009LREAL_TO_MSBLSB(M1_Presetposition_ValueMSB,LREAL#0,M1_Presetposition_ValueLSB);\u000d\u000a\u0009PosicionSetPointVirtual:=0;\u000d\u000a\u0009Virtual_Set_Position_EXE:=TRUE;\u000d\u000a\u0009VirtualCAM_Home_EXE:=TRUE;\u000d\u000a\u0009EncoderPLC:=0;\u000d\u000a\u0009S4:=TRUE;\u000d\u000a\u0009\u0009IF ABS(M1_Posicion_LREAL- EncoderPLC) <5 and I_SetPosition.Done THEN\u000d\u000a\u0009\u0009\u0009Virtual_Set_Position_EXE:=FALSE;\u000d\u000a\u0009\u0009\u0009S4:=FALSE;\u000d\u000a\u0009\u0009\u0009Home:=FALSE;\u000d\u000a\u0009\u0009END_IF;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000aIF LanzarMovimiento THEN\u000d\u000a\u0009Aux_MoveX:=TRUE;\u000d\u000a\u0009\u0009IF I_MoveAbs.Active THEN\u000d\u000a\u0009\u0009\u0009Aux_MoveX:=FALSE;\u000d\u000a\u0009\u0009\u0009LanzarMovimiento:=FALSE;\u000d\u000a\u0009\u0009END_IF;\u0009\u000d\u000aEND_IF;\u0009\u000d\u000a\u000d\u000a\u000d\u000aIF Realizar_Preset THEN\u0009\u000d\u000a\u0009LREAL_TO_MSBLSB(M1_Presetposition_ValueMSB,EncoderPLC,M1_Presetposition_ValueLSB);\u0009\u000d\u000a\u0009\u0009\u0009IF NOT Updated then\u000d\u000a\u0009\u0009\u0009\u0009Distancia_Ultimo_Movimiento:= ABS(EncoderPLC + Posicion-Offset_Encoder);\u000d\u000a\u0009\u0009\u0009\u0009Updated:=TRUE;\u000d\u000a\u0009\u0009\u0009END_IF;\u000d\u000a\u0009PosicionSetPointVirtual:=EncoderPLC;\u000d\u000a\u0009Virtual_Set_Position_EXE:=TRUE;\u0009\u000d\u000a\u0009S4:=TRUE;\u0009\u000d\u000a\u0009\u0009IF  I_SetPosition.Done then\u000d\u000a\u0009\u0009\u0009Updated:=FALSE;\u000d\u000a\u0009\u0009\u0009Virtual_Set_Position_EXE:=FALSE;\u0009\u0009\u0009\u000d\u000a\u0009\u0009\u0009Offset_Encoder:=0;\u000d\u000a\u0009\u0009\u0009S4:=FALSe;\u000d\u000a\u0009\u0009\u0009UltimoCiclo:= Contador;\u000d\u000a\u0009\u0009\u0009Contador:=0;\u000d\u000a\u0009\u0009\u0009Realizar_Preset:=FALSE;\u000d\u000a\u0009\u0009END_IF;\u0009\u000d\u000aEND_IF;\u000d\u000a\u000d\u000aIF UseEncoder THEN\u0009\u000d\u000a\u0009PosicionSetPointEncoder:=M1_Posicion_LREAL;\u000d\u000a\u0009Encoder_Set_Position_EXE:=TRUE;\u0009\u0009\u0009\u000d\u000a\u0009\u0009IF  I_SetPositionEncoder.Done then\u000d\u000a\u0009\u0009\u0009Updated:=FALSE;\u000d\u000a\u0009\u0009\u0009Encoder_Set_Position_EXE:=FALSE;\u0009\u0009\u0009\u000d\u000a\u0009\u0009\u0009UseEncoder:=FALSE;\u000d\u000a\u0009\u0009\u0009Seguir_Encoder:=TRUE;\u000d\u000a\u0009\u0009END_IF;\u0009\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\u000d\u000a\u000d\u000a\u000d\u000a\u000d\u000aIF Realizar_Preset THEN\u0009\u000d\u000a\u0009Contador:=Contador+2;\u000d\u000aEND_IF;\u0009\u000d\u000a\u0009\u000d\u000aIF Reset THEN\u000d\u000a\u0009S3:=TRUE;\u000d\u000aELSE\u000d\u000a\u0009S3:=FALSE;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000aTimerRand(T_Exe,T#10ms,T_Q,T_ET);\u000d\u000a\u0009","W":1169.6000000000001}],"LRI":1,"RRI":2,"VLs":[]}
